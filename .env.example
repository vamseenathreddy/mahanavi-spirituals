# Copy this file to .env and fill in real values. Never commit .env.

# --- Paths (defaults are fine for local dev; override for Docker) ---
MAHANAVI_IMAGES_ROOT=./Images
MAHANAVI_ASSETS_DIR=./assets
MAHANAVI_OUTPUT_DIR=./data/generated
MAHANAVI_DATABASE_PATH=./data/mahanavi.db
MAHANAVI_LOG_DIR=./data/logs

# --- Scheduling ---
MAHANAVI_TIMEZONE=Asia/Kolkata
MAHANAVI_POST_HOUR=5
MAHANAVI_POST_MINUTE=0

# --- Branding ---
MAHANAVI_CHANNEL_NAME=Mahanavi Spirituals
MAHANAVI_WATERMARK_TEXT=Mahanavi Spirituals

# --- Panchang provider: "dummy" | "api" | "scraper" ---
MAHANAVI_PANCHANG_PROVIDER=dummy
MAHANAVI_PANCHANG_API_BASE_URL=
MAHANAVI_PANCHANG_API_KEY=
MAHANAVI_PANCHANG_LATITUDE=17.3850
MAHANAVI_PANCHANG_LONGITUDE=78.4867

# --- YouTube ---
MAHANAVI_YOUTUBE_CLIENT_SECRETS_FILE=
MAHANAVI_YOUTUBE_TOKEN_FILE=./data/youtube_token.json
MAHANAVI_YOUTUBE_CHANNEL_ID=
MAHANAVI_YOUTUBE_COMMUNITY_POST_METHOD=playwright
MAHANAVI_YOUTUBE_SESSION_STATE_FILE=./data/yt_session_state.json

# --- Telegram ---
MAHANAVI_TELEGRAM_BOT_TOKEN=
MAHANAVI_TELEGRAM_CHANNEL_ID=@mahanavispirituals
MAHANAVI_TELEGRAM_ADMIN_CHAT_ID=

# --- Facebook / Instagram (optional) ---
MAHANAVI_ENABLE_FACEBOOK=false
MAHANAVI_FACEBOOK_PAGE_ID=
MAHANAVI_FACEBOOK_PAGE_ACCESS_TOKEN=
MAHANAVI_ENABLE_INSTAGRAM=false
MAHANAVI_INSTAGRAM_BUSINESS_ACCOUNT_ID=
MAHANAVI_INSTAGRAM_ACCESS_TOKEN=

# --- Retry behaviour ---
MAHANAVI_MAX_RETRIES=3
MAHANAVI_RETRY_BACKOFF_SECONDS=5
